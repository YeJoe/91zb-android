<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页。

  两种形态（由 PlayerActivity.applyMode 动态切）：
    半屏 —— 上方约 46% 是画面，下方是深色聊天区，右下角「全屏」按钮或点画面可放大；
    全屏 —— 画面铺满，聊天区变成浮在底部的半透明层，再点一下回半屏。

  page 是 SwipeLayout（可上下拖动切直播间），overlay 放在 page 内部，
  切间时整层跟着一起走，避免遮罩"钉"在原地显得动画断裂。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B">

    <!-- 拖动时被拉开的那一半：提示下一间，纯装饰 -->
    <TextView
        android:id="@+id/nextHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:text="松手切换直播间"
        android:textColor="#8B95A7"
        android:textSize="13sp" />

    <com.jjlive.app.SwipeLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 画面容器：高度在代码里按形态设置 -->
        <FrameLayout
            android:id="@+id/videoBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:background="#000000" />

        <View
            android:id="@+id/scrimTop"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <!-- 顶栏：直播中 + 主播名 + 关闭 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_live"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="直播中"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:textColor="#F2F5FA"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFollow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_dark"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="关注"
                android:textColor="#E6E9EF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnPip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_dark"
                android:gravity="center"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:text="画中画"
                android:textColor="#E6E9EF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_dark"
                android:gravity="center"
                android:text="⟳"
                android:textColor="#E6E9EF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_dark"
                android:gravity="center"
                android:text="✕"
                android:textColor="#E6E9EF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 聊天区：右滑可甩走（SlideAwayLayout），甩走后变全屏、只留右下角"聊天"胶囊 -->
        <com.jjlive.app.SlideAwayLayout
            android:id="@+id/chatPanel"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/chatHeader"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="聊天"
                    android:textColor="#E6E9EF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#6F7C90"
                    android:textSize="10.5sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnMode"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/pill_dark"
                    android:gravity="center"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:text="全屏"
                    android:textColor="#D6DEEA"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingLeft="16dp"
                android:paddingTop="2dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp"
                android:scrollbars="none" />
        </com.jjlive.app.SlideAwayLayout>

        <!-- 聊天区被右滑收起后，用这个小胶囊叫回来 -->
        <TextView
            android:id="@+id/btnChat"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="52dp"
            android:background="@drawable/pill_dark"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="聊天"
            android:textColor="#E8EDF5"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <!-- 底部信息条：清晰度 / 码率 -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <TextView
                android:id="@+id/resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_dark"
                android:paddingLeft="9dp"
                android:paddingTop="3dp"
                android:paddingRight="9dp"
                android:paddingBottom="3dp"
                android:textColor="#D6DEEA"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/pill_dark"
                android:paddingLeft="9dp"
                android:paddingTop="3dp"
                android:paddingRight="9dp"
                android:paddingBottom="3dp"
                android:textColor="#7FD1A8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 弹幕发送栏：始终压在底栏之上，聊天区收起时也能发 -->
        <LinearLayout
            android:id="@+id/sendBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="#CC0B0E14"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/etDanmu"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/pill_dark"
                android:hint="发条弹幕…"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:textColor="#F2F5FA"
                android:textColorHint="#7C8696"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_accent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="发送"
                android:textColor="@color/accent_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 上滑切间提示，几秒后自动淡出 -->
        <TextView
            android:id="@+id/swipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="200dp"
            android:background="@drawable/pill_dark"
            android:paddingLeft="14dp"
            android:paddingTop="7dp"
            android:paddingRight="14dp"
            android:paddingBottom="7dp"
            android:text="↑ 上滑切换直播间"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <!-- 加载/错误遮罩：放在 page 内，切间时跟着一起滑动 -->
        <LinearLayout
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#CFD7E6"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FF5C8A"
                android:text="重新连接"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </com.jjlive.app.SwipeLayout>

</FrameLayout>
