<?xml version="1.0" encoding="utf-8"?>
<!-- 设置面板：接口域名 / 令牌 / 弹幕地址，方便令牌失效时不重装就能换 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="6dp"
        android:paddingRight="22dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接口域名"
            android:textColor="#8B95A7"
            android:textSize="11.5sp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_field"
            android:hint="https://utp.opuxrcm.com"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="#E6E9EF"
            android:textColorHint="#5B6376"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="令牌（authorization）"
            android:textColor="#8B95A7"
            android:textSize="11.5sp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="登录后的请求头 authorization"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="#E6E9EF"
            android:textColorHint="#5B6376"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="弹幕服务（可留空，使用默认）"
            android:textColor="#8B95A7"
            android:textSize="11.5sp" />

        <EditText
            android:id="@+id/etIm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_field"
            android:hint="wss://yzj.opuxrcm.com/live"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="#E6E9EF"
            android:textColorHint="#5B6376"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#8B95A7"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:text="恢复默认值"
            android:textColor="#FF9DB6"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
